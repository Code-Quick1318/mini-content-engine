// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enum: JobStatus
// Tracks the lifecycle of a generation job.
// ─────────────────────────────────────────────
enum JobStatus {
  pending     // Job created, not yet picked up for processing
  processing  // Gemini prompt generated; image generation in progress
  completed   // Image successfully generated and stored
  failed      // An error occurred at any stage
}

// ─────────────────────────────────────────────
// Model: Job
// Represents a single AI image generation request.
// ─────────────────────────────────────────────
model Job {
  // ── Identity ──────────────────────────────
  // UUID v4 generated by PostgreSQL via gen_random_uuid().
  // Globally unique, non-sequential — safe to expose in public URLs.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // ── Input fields (provided by the client) ─
  // The name of the product being advertised.
  // Used as the primary subject when building the Gemini prompt.
  // Required. Max meaningful length enforced at the application layer.
  productName String

  // A short description of the product — material, use case, tone, etc.
  // Feeds into the Gemini prompt to give the AI stylistic context.
  // Required.
  description String

  // A publicly accessible URL to a reference image supplied by the client.
  // Gemini can use this as a visual style anchor when crafting the prompt.
  // Optional — some requests may not include a reference image.
  referenceImage String?

  // ── AI output fields (populated during processing) ─
  // The text prompt generated by Gemini from the input fields above.
  // Null until the job moves from `pending` to `processing`.
  // Stored so it can be audited, replayed, or displayed to the user.
  generatedPrompt String?

  // ── Status ────────────────────────────────
  // Current lifecycle state of the job.
  // Defaults to `pending` on creation.
  // Updated by the service layer as processing progresses.
  status JobStatus @default(pending)

  // ── Result field (populated on completion) ─
  // The URL of the AI-generated product image.
  // Null until the job reaches `completed` status.
  // Typically a URL pointing to cloud storage (e.g. S3, GCS, Cloudinary).
  resultImage String?

  // ── Timestamps ────────────────────────────
  // Set once at insert time. Never changes.
  // Useful for sorting jobs chronologically and calculating queue age.
  createdAt DateTime @default(now())

  // Auto-updated by Prisma on every write.
  // Useful for detecting stale jobs (e.g. stuck in `processing` too long).
  updatedAt DateTime @updatedAt

  // ── Indexes ───────────────────────────────
  // Speeds up polling queries that filter by status
  // (e.g. a worker fetching all `pending` jobs).
  @@index([status])

  // Speeds up sorting the jobs list by creation time.
  @@index([createdAt])

  @@map("jobs") // maps to lowercase table name in PostgreSQL
}
